rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Verified Duke members can book and write, as before.
    function isVerifiedDuke() {
      return request.auth != null &&
        request.auth.token.email.matches('.*@duke\\.edu') &&
        request.auth.token.email_verified == true;
    }

    // The Gmail admin is not a Duke address, so the Duke check alone rejects it.
    function isGmailAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.matches('(?i)^rohand97@gmail\\.com$');
    }

    function adminsDoc() {
      return /databases/$(database)/documents/settings/admins;
    }

    // Officers added on the Settings tab, including a non-Duke address.
    function isListedAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        exists(adminsDoc()) &&
        get(adminsDoc()).data.emails is list &&
        request.auth.token.email in get(adminsDoc()).data.emails;
    }

    match /{document=**} {
      // Anyone can read the database.
      allow read: if true;
      // Verified Duke members, the Gmail admin, and saved admin addresses can write.
      allow write: if isVerifiedDuke() || isGmailAdmin() || isListedAdmin();
    }
  }
}
